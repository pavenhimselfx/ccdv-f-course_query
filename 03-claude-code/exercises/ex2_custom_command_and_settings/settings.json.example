{
  "_note": "Conceptual example settings.json for this exercise. Field names and exact schema shown here illustrate the KIND of thing settings.json configures (permissions, hooks, model) — verify exact current key names against docs.claude.com before using this in a real project. Underscore-prefixed keys like this one are used here purely as inline comments for the exercise; they are not a real Claude Code convention.",

  "model": "claude-sonnet",
  "_model_comment": "Sonnet as the team default: strong enough for day-to-day coding and review work, cheaper/faster than the largest model for the high volume of routine edits this team runs through Claude Code. A specific hard task can override this per-session rather than raising the default for everyone.",

  "permissions": {
    "_comment": "Fill this in per Part B, step 1: allow test-running and file reads freely; require confirmation before anything touching git history or deleting files.",
    "allow": [
      "Read(**)",
      "Bash(pytest *)",
      "Bash(npm test*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(rm *)",
      "Write(**/migrations/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)"
    ]
  },

  "hooks": {
    "_comment": "Fill this in per Part B, step 2: a hook that runs a formatter automatically after Claude edits a file. Conceptually, a hook entry needs (a) an event to trigger on, and (b) a command to run.",
    "afterFileEdit": [
      {
        "match": "*.py",
        "command": "black --quiet \"$FILE\"",
        "_command_comment": "$FILE is the path of the file that was just edited. --quiet keeps it from cluttering the session with formatter output when there's nothing to report."
      }
    ]
  }
}
